{
  "name": "starminer-public",
  "main": "./worker.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/index.html"
    ]
  },
  "routes": [
    {
      "pattern": "work.tanshuai.com",
      "custom_domain": true
    }
  ]
}
